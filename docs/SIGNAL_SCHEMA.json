  "type": "object",
  "required": [
    "mode",
    "source",
    "kind",
    "label",
    "brokerOrderId",
    "brokerPositionId",
    "rangeKind",
    "wasBeyond",
    "wallId",
    "boxInstanceId",
    "symbol",
    "side",
    "entry",
    "stopLoss",
    "takeProfit",
    "ladderGrade",
    "stamp",
    "l2Class",
    "l2Word",
    "l2DbandDigit",
    "l2BirthRank",
    "l2ChurnBand",
    "l2PosInWin",
    "tapHash",
    "clientEventId",
    "refClientEventId",
    "tier",
    "cell",
    "rfx",
    "inverted",
    "orderType",
    "volume",
    "grade",
    "ladderArm",
    "detail",
    "dryRun",
    "machineId",
    "robotName",
    "accountId",
    "connectionName",
