      "examples": [
        "r01Auto",
        "r01Local"
      ]
    },
    "kind": {
      "type": "string",
      "examples": [
        "cancelled",
        "heartbeat",
        "intent",
        "refused",
        "touched"
      ]
    },
    "label": {
      "type": "string"
    },
    "brokerOrderId": {
      "type": "string"
    },
    "brokerPositionId": {
      "type": "string"
    },
    "rangeKind": {
      "type": "string"
    },
    "wasBeyond": {
      "type": "boolean"
    },
    "wallId": {
      "type": "string"
    },
    "boxInstanceId": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "examples": [
        "",
        "long",
        "short"
      ]
    },
    "entry": {
      "type": "number"
    },
    "stopLoss": {
      "type": "number"
    },
    "takeProfit": {
      "type": "number"
    },
    "ladderGrade": {
      "type": "string"
    },
    "stamp": {
      "type": "number"
    },
    "l2Class": {
      "type": "string"
    },
    "l2Word": {
      "type": "string"
    },
    "l2DbandDigit": {
      "type": "integer"
    },
    "l2BirthRank": {
      "type": "integer"
    },
    "l2ChurnBand": {
      "type": "string"
    },
    "l2PosInWin": {
      "type": "boolean"
    },
    "tapHash": {
      "type": "string"
    },
    "clientEventId": {
      "type": "string"
    },
    "refClientEventId": {
      "type": "string"
    },
    "tier": {
      "type": "string"
    },
    "cell": {
      "type": "string"
    },
    "rfx": {
      "type": "string"
    },
    "inverted": {
      "type": "boolean"
    },
    "orderType": {
      "type": "string",
      "examples": [
        "",
        "limit"
      ]
