    "volume": {
      "type": "number"
    },
    "grade": {
      "type": "string"
    },
    "ladderArm": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "dryRun": {
      "type": "boolean"
    },
    "machineId": {
      "type": "string"
    },
    "robotName": {
      "type": "string"
    },
    "accountId": {
      "type": "string"
    },
    "connectionName": {
      "type": "string"
    },
    "timestampUtc": {
      "type": "string",
      "format": "date-time"
    },
    "sequence": {
      "type": "integer"
    },
    "instrument": {
      "type": "null",
      "description": "All observed values are null. Expand this definition when a populated instrument payload is captured."
    }
