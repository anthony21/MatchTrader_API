  "properties": {
    "schema_version": {
      "default": 1,
      "enum": [
        1,
        "1.0.0",
        "1.1.0"
      ],
      "title": "Schema Version"
    },
    "event_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "machine": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Machine",
      "type": "string"
    },
    "connection_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Connection Id",
      "type": "string"
    },
    "account_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Account Id",
      "type": "string"
    },
    "order_id": {
      "default": "",
      "maxLength": 200,
      "title": "Order Id",
      "type": "string"
    },
    "position_id": {
      "default": "",
      "maxLength": 200,
      "title": "Position Id",
      "type": "string"
    },
    "execution_id": {
      "default": "",
