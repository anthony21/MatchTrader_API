      "format": "date-time",
      "title": "Emitted At",
      "type": "string"
    },
    "kind": {
      "enum": [
        "REQUEST",
        "ACCEPTED",
        "REJECTED",
        "ORDER",
        "FILL",
        "POSITION",
        "SIGNAL",
        "ACCOUNT"
      ],
      "title": "Kind",
      "type": "string"
    },
    "action": {
      "default": "OBSERVE",
      "enum": [
        "CREATE",
        "EDIT",
        "CANCEL",
        "CLOSE",
        "OBSERVE"
