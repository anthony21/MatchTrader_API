      "type": "string"
    },
    "sending_source": {
      "default": "",
      "maxLength": 200,
      "title": "Sending Source",
      "type": "string"
    },
    "source_label": {
      "default": "",
      "maxLength": 200,
      "title": "Source Label",
      "type": "string"
    },
    "status": {
      "default": "",
      "maxLength": 100,
      "title": "Status",
      "type": "string"
    },
    "snapshot": {
      "default": false,
