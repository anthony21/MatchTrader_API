# Use the Match-Trader terminal URL supplied by your broker, not its marketing website.
MTR_PLATFORM_URL=https://your-broker-terminal.example
MTR_EMAIL=
MTR_PASSWORD=
# Optional: discovered through /manager/platform-details when omitted.
MTR_BROKER_ID=
# Required if login returns multiple accounts: use the Match-Trader trading account ID.
MTR_ACCOUNT_ID=
# Optional explicit broker-provided API origin. Never filled from an untrusted response automatically.
MTR_TRADING_URL=
# Optional; otherwise taken from the selected account's offer.system.uuid.
MTR_SYSTEM_UUID=
# Docs conflict about the co-auth cookie. Start with session; broker may require account.
MTR_COOKIE_MODE=session
# refresh uses /manager/refresh-token; login reauthenticates through /manager/mtr-login.
# Automatic renewal occurs on the next trading request after 15 minutes, or one read-only 401.
MTR_SESSION_RENEWAL=refresh
MTR_TIMEOUT_SECONDS=20
MTR_REQUESTS_PER_MINUTE=450
# Read operations work without enabling writes. Explicitly enable for order mutations/registration.
MTR_ENABLE_WRITES=false
# Optional, broker-confirmed streaming URL. No default protocol or subscription is invented.
MTR_WS_URL=
MTR_WS_SUBPROTOCOL=
# Optional JSON object of broker-prescribed WebSocket headers. Never committed or logged.
MTR_WS_HEADERS_JSON={}
MTR_WS_PING_INTERVAL=20
MTR_WS_MAX_SIZE=1048576

# Local Vue dashboard and shadow bridge. Comma-separated additional configured account IDs.
# A successful login also discovers accounts; credentials never go into frontend variables.
MTR_ACCOUNT_IDS=
# Optional path to R01_TRADES.csv. Capture begins at EOF on each Start.
MTR_R01_LEDGER=

# Application async HTTP pool; SDK settings above remain unchanged.
# Nonprimary brokers use their own prefix, for example GTR_HTTP_MAX_CONNECTIONS.
MTR_HTTP_EXPECTED_CONCURRENCY=16
MTR_HTTP_MAX_CONNECTIONS=24
MTR_HTTP_MAX_KEEPALIVE_CONNECTIONS=16
MTR_HTTP_KEEPALIVE_EXPIRY=15
MTR_HTTP_CONNECT_TIMEOUT=1.5
MTR_HTTP_READ_TIMEOUT=20
MTR_HTTP_WRITE_TIMEOUT=20
MTR_HTTP_POOL_TIMEOUT=0.25
